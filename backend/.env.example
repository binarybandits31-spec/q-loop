# Database — Supabase PostgreSQL (replace [password] with your project DB password)
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.zazkmdwswqhrftrjaemj.supabase.co:5432/postgres

# Sync URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:[password]@db.zazkmdwswqhrftrjaemj.supabase.co:5432/postgres

# JWT
SECRET_KEY=change-this-to-a-random-32-byte-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase (for verifying frontend tokens)
SUPABASE_URL=https://zazkmdwswqhrftrjaemj.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# OpenAI (optional — AI endpoints degrade gracefully without it)
OPENAI_API_KEY=

# App
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_CIRCUIT_QUBITS=10
MAX_SHOTS=65536
CODE_EXECUTION_TIMEOUT=30
