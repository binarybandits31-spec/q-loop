# Copy this file to ".env" in the project root and fill in the values.
# Never commit the real .env file.

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# --- Backend (optional overrides) ---
# If these are not set, the backend uses the defaults in backend/app/core/config.py
# (local PostgreSQL at localhost:5432, database "qloop", user "postgres").
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/qloop
# SYNC_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/qloop
# SECRET_KEY=
# OPENAI_API_KEY=
